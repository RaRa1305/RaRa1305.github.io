---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} · Rakshit Ranka`} description={post.data.description}>
  <article class="narrow">
    <p class="mono" style="margin:0 0 0.3rem;color:var(--rust);">
      {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
      {post.data.tags.length > 0 && <span> &middot; {post.data.tags.join(", ")}</span>}
    </p>
    <h1 style="font-size:1.8rem;font-weight:500;margin:0 0 1.5rem;">{post.data.title}</h1>
    <div style="line-height:1.75;">
      <Content />
    </div>
  </article>
</BaseLayout>
