---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="blog · Rakshit Ranka" description="Writing, thoughts, and random stuff.">
  <div class="narrow">
    <h1 style="font-size:1.6rem;font-weight:500;margin:0 0 2rem;color:var(--rust);">blog</h1>
    {posts.length === 0 && <p class="mono">No posts yet.</p>}
    {
      posts.map((post) => (
        <article style="margin-bottom:2.2rem;padding-bottom:2.2rem;border-bottom:0.5px solid var(--rule);">
          <p class="mono" style="margin:0 0 0.3rem;color:var(--rust);">
            {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            {post.data.tags.length > 0 && <span> &middot; {post.data.tags.join(", ")}</span>}
          </p>
          <h2 style="font-size:1.25rem;font-weight:500;margin:0 0 0.4rem;">
            <a href={`/blog/${post.id}`} style="color:var(--ink);">{post.data.title}</a>
          </h2>
          <p style="margin:0;color:var(--ink-soft);">{post.data.description}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
