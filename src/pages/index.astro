---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Rakshit Ranka">
  <div class="hero-section">
  <div class="narrow">
    <h1 style="font-size:2rem;font-weight:500;margin:0 0 0.3rem;">Rakshit Ranka</h1>
    <p class="mono" style="margin:0 0 1.2rem;">CSE Junior @ IIT Kharagpur</p>
    <p style="margin:0 0 1.5rem;">
      Trying to figure things out.
    </p>
    <div style="display:flex;gap:0.6rem;">
      <a class="mono" href="/resume.pdf" style="border:0.5px solid var(--rule);border-radius:4px;padding:0.4rem 0.8rem;">resume</a>
      <a class="mono" href="https://github.com/RaRa1305" style="border:0.5px solid var(--rule);border-radius:4px;padding:0.4rem 0.8rem;">github</a>
      <a class="mono" href="https://www.linkedin.com/in/rakshit-ranka-5992052b9/" style="border:0.5px solid var(--rule);border-radius:4px;padding:0.4rem 0.8rem;">linkedin</a>
    </div>
  </div>
  
  <img src="/ProfilePhoto.jpg" alt="Rakshit Ranka" class="hero-photo" />
</div>

<div>
  <p class="mono" style="color:var(--rust);margin:0 0 0.7rem;">Recent</p>
  {blogPosts.length === 0 && <p class="mono">Nothing here yet.</p>}
  <ul style="list-style:none;margin:0;padding:0;">
    {blogPosts.map((post) => (
      <li style="margin-bottom:0.6rem;">
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
        <span class="tag"> &middot; {post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
      </li>
    ))}
  </ul>
</div>
</BaseLayout>
