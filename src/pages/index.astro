---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Rakshit Ranka">
  <div class="hero-section">
    <div class="narrow">
      <h1 style="font-size:2rem;font-weight:500;margin:0 0 0.3rem;">Rakshit Ranka</h1>
      <p class="mono" style="margin:0 0 0.8rem;">CSE Junior @ IIT Kharagpur</p>
      <div style="display:flex;gap:0.6rem;margin:0 0 1.2rem;">
        <a class="mono" href="/resume.pdf" style="border:0.5px solid var(--rule);border-radius:4px;padding:0.4rem 0.8rem;display:inline-block;">resume</a>
        <a class="mono" href="https://github.com/RaRa1305" target="_blank" style="border:0.5px solid var(--rule);border-radius:4px;padding:0.4rem 0.8rem;display:inline-block;">github</a>
      </div>
      <p style="margin:0;">
        Trying to figure things out.
      </p>
    </div>
    <img src="/Luffy.png" alt="Rakshit Ranka" class="hero-photo" />
  </div>

  {blogPosts.length > 0 && (
    <div style="margin-bottom: 2.5rem;">
      <p class="mono" style="color:var(--rust);margin:0 0 0.7rem;">Recent</p>
      <ul style="list-style:none;margin:0;padding:0;">
        {blogPosts.map((post) => (
          <li style="margin-bottom:0.6rem;">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <span class="tag"> &middot; {post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div style="border-top:0.5px solid var(--rule);padding-top:1.5rem;margin-top:2.5rem;">
    <p class="mono" style="color:var(--ink-soft);margin:0 0 0.6rem;">GET IN TOUCH</p>
    <div style="display:flex;gap:0.6rem;">
      <a href="mailto:rakshitcosmo13@gmail.com" aria-label="Email" style="border:0.5px solid var(--rule);border-radius:4px;width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/rakshit-ranka-5992052b9/" target="_blank" aria-label="LinkedIn" style="border:0.5px solid var(--rule);border-radius:4px;width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
    </div>
  </div>
</BaseLayout>
